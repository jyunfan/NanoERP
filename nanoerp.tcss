Screen {
    align: center middle;
}

#menu-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#menu-list {
    width: 50;
    height: auto;
    border: solid $primary;
    margin: 1 0;
}

#placeholder-message {
    text-align: center;
    padding: 2 4;
    border: dashed $warning;
    width: 60;
    height: auto;
}

QuitScreen {
    align: center middle;
}

#quit-dialog {
    width: 40;
    height: auto;
    border: thick $error;
    padding: 1 2;
    background: $surface;
}

#quit-message {
    text-align: center;
    padding: 0 0 1 0;
}

#quit-buttons {
    align: center middle;
    height: auto;
    width: 100%;
}

#quit-buttons Button {
    margin: 0 1;
}

#customer-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#customer-table {
    width: 100%;
    height: 1fr;
}

#cell-editor {
    dock: bottom;
    width: 100%;
    margin: 0 1;
}

CustomerScreen SelectOverlay {
    height: auto;
    max-height: 10;
}

#product-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#product-table {
    width: 100%;
    height: 1fr;
}

#supplier-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#supplier-table {
    width: 100%;
    height: 1fr;
}

#order-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#order-container {
    width: 100%;
    height: 1fr;
}

#customer-list {
    width: 28;
    height: 100%;
    border: solid $primary;
}

#order-middle {
    width: 1fr;
    height: 100%;
}

#order-prompt {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    text-style: bold;
}

#order-table {
    width: 100%;
    height: 100%;
}

#order-total-table {
    width: 28;
    height: 100%;
    border: solid $primary;
}

OrderScreen OptionList {
    height: 1fr;
}

#total-check-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#total-check-table {
    width: 100%;
    height: 1fr;
}

#report-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#report-container {
    width: 100%;
    height: 1fr;
}

#report-left {
    width: 28;
    height: 100%;
}

#market-select {
    width: 100%;
}

#report-customer-list {
    width: 100%;
    height: 1fr;
    border: solid $primary;
}

#report-table {
    width: 1fr;
    height: 100%;
}

#shipping-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#shipping-container {
    width: 100%;
    height: 1fr;
}

#shipping-left {
    width: 28;
    height: 100%;
}

#shipping-market-select {
    width: 100%;
}

#shipping-customer-list {
    width: 100%;
    height: 1fr;
    border: solid $primary;
}

#shipping-document {
    width: 1fr;
    height: 100%;
}

#shipping-document-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    padding: 1 2;
}

#shipping-table {
    width: 100%;
    height: 1fr;
}

#checkout-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#checkout-container {
    width: 100%;
    height: 1fr;
}

#checkout-left {
    width: 28;
    height: 100%;
}

#checkout-market-select {
    width: 100%;
}

#checkout-customer-list {
    width: 100%;
    height: 1fr;
    border: solid $primary;
}

#checkout-table {
    width: 1fr;
    height: 100%;
}

#purchase-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    padding: 1 2;
    width: 100%;
}

#purchase-container {
    width: 100%;
    height: 1fr;
}

#supplier-list {
    width: 28;
    height: 100%;
    border: solid $primary;
}

#purchase-table {
    width: 1fr;
    height: 100%;
}

PurchaseScreen OptionList {
    height: 1fr;
}

DateDialog {
    align: center middle;
}

#date-dialog {
    width: 40;
    height: auto;
    border: thick $primary;
    padding: 1 2;
    background: $surface;
}

#date-prompt {
    text-align: center;
    padding: 0 0 1 0;
}
